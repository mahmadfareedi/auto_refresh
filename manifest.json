{
  "manifest_version": 3,
  "name": "Refresh App",
  "version": "0.3.0",
  "description": "Clear cache, trigger hard refreshes, or schedule normal reloads from a polished popup.",
  "permissions": [
    "activeTab",
    "browsingData",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Refresh App",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/refresh-16.png",
      "32": "icons/refresh-32.png",
      "48": "icons/refresh-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/refresh-16.png",
    "32": "icons/refresh-32.png",
    "48": "icons/refresh-48.png",
    "128": "icons/refresh-128.png"
  }
}
